name: Temporary Trippin story and profile checks
on:
  create:
permissions:
  contents: read
jobs:
  story-profile:
    if: github.repository == 'alvarovillalbaa/trippin' && github.event.repository.private == false && github.event.ref_type == 'branch' && github.event.ref == 'qa/trippin-story-profile-20261111-1'
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    env:
      SOURCE_COMMIT: APPROVED_SOURCE_COMMIT
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: ${{ env.SOURCE_COMMIT }}
          persist-credentials: false
          fetch-depth: 2
          clean: false
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1
        with:
          node-version: '24.21.0'
      - name: Bind the source and prepare isolated browser tools
        shell: bash
        run: |
          set -euo pipefail
          test "$(git rev-parse HEAD)" = "$SOURCE_COMMIT"
          git diff --exit-code c4103cade48221d264aeaedbcde7ac0c879f072e -- app components lib public package.json package-lock.json
          node --check tests/integration/browser/story-profile.spec.mjs
          git ls-files -z | xargs -0 sha256sum > "$RUNNER_TEMP/trippin-story-source.sha256"
          TRIPPIN_STORY_ROOT="$(mktemp -d "$RUNNER_TEMP/trippin-story-XXXXXX")"
          chmod 700 "$TRIPPIN_STORY_ROOT"
          echo "TRIPPIN_STORY_ROOT=$TRIPPIN_STORY_ROOT" >> "$GITHUB_ENV"
          mkdir "$TRIPPIN_STORY_ROOT/results" "$TRIPPIN_STORY_ROOT/cache"
          echo '{"private":true,"dependencies":{"@playwright/test":"1.65.0"}}' > "$TRIPPIN_STORY_ROOT/package.json"
          npm install --prefix "$TRIPPIN_STORY_ROOT" --ignore-scripts --no-audit --no-fund --cache "$TRIPPIN_STORY_ROOT/cache"
          node - "$TRIPPIN_STORY_ROOT" <<'JS'
          const fs = require('node:fs'), path = require('node:path'), assert = require('node:assert/strict');
          const root = process.argv[2], lock = JSON.parse(fs.readFileSync(path.join(root,'package-lock.json')));
          const pins = {
            '@playwright/test':'sha512-iGURLGuKDLakSEl7Pgfv8h7f+XLT+V861Wfhz0zlEl5nyFuKUopdkFBPKqTllTUp06aOwPuH8iuUEb3yp3MpbQ==',
            'playwright':'sha512-F3AMWcR44qMBt4kq+6Kb6mX7bjGXshktKFOPULd7reED6ZJWevjbNRqysP7q+AATE9kdPEZBibex1BYsvpVoeA==',
            'playwright-core':'sha512-vNSKgH6YqtN7cdT/L334zo0a+YwkrpicyrHJlWWPIm/Q+Nn2SWInil01oT0mbu96U4GgoRtCYQD9CzJQgju+lA=='
          };
          assert.deepEqual(Object.keys(lock.packages).sort(),['',...Object.keys(pins).map(name=>'node_modules/'+name)].sort());
          for (const [name,integrity] of Object.entries(pins)) {
            const item = lock.packages['node_modules/'+name];
            assert.equal(item.version,'1.65.0'); assert.equal(item.integrity,integrity);
          }
          JS
          cp tests/integration/browser/story-profile.spec.mjs "$TRIPPIN_STORY_ROOT/story-profile.spec.mjs"
          cat > "$TRIPPIN_STORY_ROOT/playwright.config.mjs" <<'JS'
          export default {
            testDir:'.', testMatch:'story-profile.spec.mjs', workers:1, retries:0,
            timeout:120000, globalTimeout:300000, expect:{timeout:10000},
            outputDir:'results/files', reporter:[['list'],['json',{outputFile:'results/report.json'}]]
          };
          JS
          PLAYWRIGHT_BROWSERS_PATH="$TRIPPIN_STORY_ROOT/browsers" "$TRIPPIN_STORY_ROOT/node_modules/.bin/playwright" install --with-deps --only-shell chromium
      - name: Run both actual hosted journeys
        shell: bash
        run: |
          set -euo pipefail
          cd "$TRIPPIN_STORY_ROOT"
          PLAYWRIGHT_BROWSERS_PATH="$TRIPPIN_STORY_ROOT/browsers" ./node_modules/.bin/playwright test
      - name: Verify source preservation and browser closure
        if: always()
        shell: bash
        run: |
          set -euo pipefail
          sha256sum --check "$RUNNER_TEMP/trippin-story-source.sha256" > "$RUNNER_TEMP/trippin-story-source-check.txt"
          python3 - "$TRIPPIN_STORY_ROOT" <<'PY'
          import json, os, pathlib, sys, time
          root = pathlib.Path(sys.argv[1])
          assert root.parent == pathlib.Path(os.environ['RUNNER_TEMP']) and root.name.startswith('trippin-story-') and not root.is_symlink()
          remaining = []
          for attempt in range(40):
              remaining = []
              for item in pathlib.Path('/proc').iterdir():
                  if not item.name.isdigit(): continue
                  try:
                      args = (item/'cmdline').read_bytes().split(b'\0')
                      if any(value.startswith(os.fsencode(root)+b'/') for value in args): remaining.append(int(item.name))
                  except (FileNotFoundError, ProcessLookupError): pass
              if not remaining: break
              time.sleep(0.1)
          (root/'results/cleanup.json').write_text(json.dumps({'ownedProcessesRemaining':remaining,'sourceHashesVerified':True})+'\n')
          assert not remaining
          PY
      - name: Retain the report and actual downloads
        if: always()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9
        with:
          name: trippin-story-profile-${{ github.run_id }}
          path: |
            ${{ env.TRIPPIN_STORY_ROOT }}/results
            ${{ runner.temp }}/trippin-story-source.sha256
            ${{ runner.temp }}/trippin-story-source-check.txt
          retention-days: 1
          if-no-files-found: error
      - name: Remove owned browser tools after verified closure
        if: always()
        shell: bash
        run: |
          python3 - "$TRIPPIN_STORY_ROOT" <<'PY'
          import json, os, pathlib, shutil, sys
          root = pathlib.Path(sys.argv[1])
          assert root.parent == pathlib.Path(os.environ['RUNNER_TEMP']) and root.name.startswith('trippin-story-') and not root.is_symlink()
          cleanup = json.loads((root/'results/cleanup.json').read_bytes())
          assert cleanup == {'ownedProcessesRemaining':[],'sourceHashesVerified':True}
          shutil.rmtree(root)
          assert not root.exists()
          PY
