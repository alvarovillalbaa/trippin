// INACTIVE: copy only into an explicitly approved disposable CI checkout.
// Five real DOM scenarios run once per desktop/mobile Chromium project.
import { test as base, expect, type BrowserContext, type Page, type Response } from '@playwright/test';
import { createHash } from 'node:crypto';
import { isWorkspace } from '../../lib/trip';
import type { Activity, Trip, WorkspaceState } from '../../lib/types';

const ORIGIN = 'https://trippin-theta.vercel.app';
const EXPECTED_DEPLOYMENT = process.env.TRIPPIN_EXPECTED_DEPLOYMENT || '';
if (!/^dpl_[A-Za-z0-9]+$/.test(EXPECTED_DEPLOYMENT)) {
  throw new Error('Set TRIPPIN_EXPECTED_DEPLOYMENT to the READY deployment ID served by the public alias.');
}
const STORAGE_KEY = 'trippin.workspace.v1';
const DATE = '2026-11-03';
const RAW_CAP = 16 * 1024 * 1024;
const csvInput = 'input[type="file"][accept=".csv,text/csv"]';
const backupInput = 'input[type="file"][accept="application/json,.json"]';

function stop(tripIndex: number, index: number): Activity {
  return {
    id: `browser-qa-stop-${tripIndex}-${index}`, title: `Authored stop ${index}`,
    category: 'culture', description: '', time: '09:00', duration: 30, cost: 0,
    lat: 40.4, lng: -3.7, location: 'Authored square', status: 'planned', source: 'custom',
  };
}
function privateTrip(index: number): Trip {
  return {
    id: `browser-qa-trip-${index}`, title: `Private authored trip ${index}`,
    city: `QA City ${index}`, country: 'Spain', countryCode: 'ES',
    startDate: DATE, endDate: DATE, lat: 40.4, lng: -3.7,
    image: '/images/munich.jpg', description: 'Authored acceptance data only.',
    budget: 1000, currency: 'EUR',
    days: [{ id: `browser-qa-day-${index}`, date: DATE, label: 'Authored day', activities: [stop(index, 0)] }],
    expenses: [{ id: `browser-qa-expense-${index}`, title: 'Kept authored expense', category: 'food', amount: 3.5, date: DATE }],
    bookings: [], isPublic: false, joinRequests: [], companions: [],
  };
}
function workspace(): WorkspaceState {
  const value: WorkspaceState = {
    version: 1, trips: [privateTrip(0)], selectedTripId: 'browser-qa-trip-0',
    profile: {
      name: 'Authored backup owner', bio: 'Disposable browser fixture.', homeCity: 'QA City',
      interests: [], openToEvents: [], dailyFoodBudget: 0, dailyTransportBudget: 0, badges: [],
    },
  };
  if (!isWorkspace(value)) throw new Error('The authored fixture does not satisfy the actual workspace model.');
  return value;
}
function largeWorkspace(character: string): WorkspaceState {
  const value = workspace();
  value.trips = Array.from({ length: 9 }, (_, index) => {
    const trip = privateTrip(index);
    trip.days[0].activities = Array.from({ length: 60 }, (_, stopIndex) => stop(index, stopIndex));
    return trip;
  });
  value.selectedTripId = value.trips.at(-1)!.id;
  value.profile.name = character === '漢' ? 'CJK backup fixture' : 'Legacy pretty backup fixture';
  const target = 1_999_900;
  let remaining = target - JSON.stringify(value).length;
  if (remaining <= 0) throw new Error('Fixture metadata exceeds its intended size.');
  for (const trip of value.trips) for (const activity of trip.days[0].activities) {
    const length = Math.min(4000, remaining);
    activity.description = character.repeat(length);
    remaining -= length;
  }
  if (remaining !== 0 || JSON.stringify(value).length !== target || !isWorkspace(value)) {
    throw new Error('The bounded nine-trip/sixty-stop fixture is invalid.');
  }
  return value;
}

type DeploymentObservation = {
  status: number; sameOrigin: boolean; rootPath: boolean;
  deploymentIdCount: number | null; matchesExpected: boolean;
};
type PublicStackFrame = { assetPath: string; line: number; column: number };
type Guard = {
  unexpected: string[]; blockedApi: number; blockedWeather: number; blockedTiles: number;
  blockedFonts: number;
  allowedAppReads: number; blockedMutations: number; blockedUnexpectedReads: number;
  blockedWebSockets: number; pageErrorCount: number; pageErrorFingerprints: string[];
  pageErrorDiagnostics: { name: string; message: string; sha256: string; rootNavigationCount: number; frames: PublicStackFrame[] }[];
  rootNavigations: DeploymentObservation[];
};
function diagnosticText(value: string, maximumBytes: number): string {
  const redacted = value.replace(/https?:\/\/[^\s"'<>]+/g, raw => {
    try { const url = new URL(raw); return url.origin + url.pathname; }
    catch { return '[url]'; }
  }).replace(/(?:data|blob):[^\s"'<>]+/g, '[url]').replace(/[\u0000-\u001f\u007f]/g, ' ');
  let end = 0, bytes = 0;
  for (const character of redacted) {
    const size = Buffer.byteLength(character);
    if (bytes + size > maximumBytes) break;
    end += character.length; bytes += size;
  }
  return redacted.slice(0, end);
}
function publicStackFrames(stack: string, limit: number): PublicStackFrame[] {
  const frames: PublicStackFrame[] = [];
  if (limit <= 0) return frames;
  for (const line of stack.split('\n', 65)) {
    const match = line.match(/(https?:\/\/[^\s]+):([1-9]\d{0,8}):([1-9]\d{0,8})\)?\s*$/);
    if (!match) continue;
    try {
      const url = new URL(match[1]);
      if (url.origin !== ORIGIN || url.username || url.password || !url.pathname.startsWith('/_next/static/')
        || !url.pathname.endsWith('.js') || Buffer.byteLength(url.pathname) > 256) continue;
      frames.push({ assetPath: url.pathname, line: Number(match[2]), column: Number(match[3]) });
      if (frames.length >= limit) break;
    } catch { /* Non-URL stack entries are outside the public asset diagnostic. */ }
  }
  return frames;
}
type Fixtures = { authoredWorkspace: WorkspaceState; networkGuard: Guard };
const guards = new WeakMap<BrowserContext, Guard>();
const test = base.extend<Fixtures>({
  authoredWorkspace: [workspace(), { option: true }],
  storageState: async ({ authoredWorkspace }, use) => {
    if (!isWorkspace(authoredWorkspace) || authoredWorkspace.trips.some(trip => trip.isPublic)) {
      throw new Error('Use only private, valid authored workspace fixtures.');
    }
    await use({
      cookies: [],
      origins: [{ origin: ORIGIN, localStorage: [{ name: STORAGE_KEY, value: JSON.stringify(authoredWorkspace) }] }],
    });
  },
  networkGuard: [async ({ context }, use, testInfo) => {
    const guard: Guard = {
      unexpected: [], blockedApi: 0, blockedWeather: 0, blockedTiles: 0, blockedFonts: 0,
      allowedAppReads: 0, blockedMutations: 0, blockedUnexpectedReads: 0,
      blockedWebSockets: 0, pageErrorCount: 0, pageErrorFingerprints: [], pageErrorDiagnostics: [], rootNavigations: [],
    };
    const unexpected = (kind: string) => {
      if (guard.unexpected.length < 20) guard.unexpected.push(kind);
    };
    const onWebError = (event: { error(): Error }) => {
      guard.pageErrorCount++;
      if (guard.pageErrorFingerprints.length < 8) {
        const error = event.error();
        const sha256 = createHash('sha256').update(error.name + '\n' + error.message).digest('hex');
        guard.pageErrorFingerprints.push(sha256);
        if (guard.pageErrorDiagnostics.length < 4) {
          const remainingFrames = 8 - guard.pageErrorDiagnostics.reduce((sum, item) => sum + item.frames.length, 0);
          guard.pageErrorDiagnostics.push({
            name: diagnosticText(error.name, 64), message: diagnosticText(error.message, 384), sha256,
            rootNavigationCount: guard.rootNavigations.length, frames: publicStackFrames(error.stack || '', remainingFrames),
          });
        }
      }
    };
    guards.set(context, guard);
    context.on('weberror', onWebError);
    try {
      await context.routeWebSocket('**/*', async route => {
        guard.blockedWebSockets++; unexpected('websocket');
        await route.close({ code: 1008, reason: 'Outside acceptance scope' });
      });
      await context.route('**/*', async route => {
        const request = route.request(), url = new URL(request.url());
        if (!['GET', 'HEAD'].includes(request.method())) {
          guard.blockedMutations++; unexpected('mutation');
          await route.abort('blockedbyclient');
        } else if (url.origin === ORIGIN && (url.pathname === '/api' || url.pathname.startsWith('/api/'))) {
          guard.blockedApi++;
          await route.abort('blockedbyclient');
        } else if (url.origin === ORIGIN && (url.pathname === '/' || url.pathname.startsWith('/_next/')
          || url.pathname.startsWith('/images/') || ['/icon.svg', '/favicon.ico'].includes(url.pathname))) {
          guard.allowedAppReads++;
          await route.continue();
        } else if ((url.origin === 'https://fonts.googleapis.com' && url.pathname === '/css2')
          || (url.origin === 'https://fonts.gstatic.com' && url.pathname.startsWith('/s/') && /\.(?:woff2?|ttf|otf)$/.test(url.pathname))) {
          guard.blockedFonts++;
          await route.abort('blockedbyclient');
        } else if (url.origin === 'https://api.open-meteo.com' && url.pathname === '/v1/forecast') {
          guard.blockedWeather++;
          await route.abort('blockedbyclient');
        } else if (url.origin === 'https://tile.openstreetmap.org' && /^\/\d+\/\d+\/\d+\.png$/.test(url.pathname)) {
          guard.blockedTiles++;
          await route.abort('blockedbyclient');
        } else {
          guard.blockedUnexpectedReads++; unexpected('unexpected-read');
          await route.abort('blockedbyclient');
        }
      });
      await use(guard);
    } finally {
      try {
        const body = Buffer.from(JSON.stringify({
          schemaVersion: 1, kind: 'trippin-browser-boundary',
          blockedApi: guard.blockedApi, blockedWeather: guard.blockedWeather, blockedTiles: guard.blockedTiles,
          blockedFonts: guard.blockedFonts,
          allowedAppReads: guard.allowedAppReads, blockedMutations: guard.blockedMutations,
          blockedUnexpectedReads: guard.blockedUnexpectedReads, blockedWebSockets: guard.blockedWebSockets,
          unexpectedCount: guard.blockedMutations + guard.blockedUnexpectedReads + guard.blockedWebSockets,
          pageErrorCount: guard.pageErrorCount, pageErrorFingerprints: guard.pageErrorFingerprints,
          pageErrorDiagnostics: guard.pageErrorDiagnostics,
          rootNavigations: guard.rootNavigations,
        }));
        if (body.byteLength > 8192) throw new Error('The boundary attachment exceeded its fixed bound.');
        await testInfo.attach('trippin-browser-boundary', { body, contentType: 'application/json' });
        expect(guard.unexpected, 'No cross-origin request or app-origin mutation may escape the guard.').toEqual([]);
        expect(guard.pageErrorCount, 'Uncaught page errors must fail the browser case.').toBe(0);
        console.log(`Out-of-scope reads blocked: api=${guard.blockedApi}, weather=${guard.blockedWeather}, tiles=${guard.blockedTiles}, fonts=${guard.blockedFonts}; pageErrors=${guard.pageErrorCount}`);
      } finally {
        context.off('weberror', onWebError);
        guards.delete(context);
      }
    }
  }, { auto: true }],
});
function digest(value: unknown): string {
  return createHash('sha256').update(JSON.stringify(value)).digest('hex');
}
async function expectDeployment(response: Response | null): Promise<void> {
  if (!response) throw new Error('The public root navigation did not return an HTTP response.');
  const url = new URL(response.url());
  const guard = guards.get(response.request().frame().page().context());
  if (!guard || guard.rootNavigations.length >= 8) throw new Error('Root navigation evidence is missing or exceeds its bound.');
  const observation: DeploymentObservation = {
    status: response.status(), sameOrigin: url.origin === ORIGIN, rootPath: url.pathname === '/',
    deploymentIdCount: null, matchesExpected: false,
  };
  guard.rootNavigations.push(observation);
  expect(response.status()).toBe(200);
  expect(url.origin).toBe(ORIGIN);
  expect(url.pathname).toBe('/');
  const ids = [...new Set((await response.text()).match(/\bdpl_[A-Za-z0-9]+\b/g) || [])];
  observation.deploymentIdCount = ids.length;
  observation.matchesExpected = ids.length === 1 && ids[0] === EXPECTED_DEPLOYMENT;
  expect(ids, 'The actual root HTML must contain only the approved deployment ID.').toEqual([EXPECTED_DEPLOYMENT]);
}
async function stored(page: Page): Promise<WorkspaceState> {
  const raw = await page.evaluate(key => localStorage.getItem(key), STORAGE_KEY);
  if (raw === null) throw new Error('The owned durable workspace is missing.');
  const value: unknown = JSON.parse(raw);
  if (!isWorkspace(value)) throw new Error('The actual durable workspace fails the model.');
  return value;
}
async function expectStored(page: Page, expected: WorkspaceState): Promise<void> {
  // Hash full JSON to keep a failed large-workspace assertion out of CI logs.
  await expect.poll(async () => digest(await stored(page))).toBe(digest(expected));
}
async function profile(page: Page): Promise<void> {
  await page.getByRole('button', { name: 'Your profile', exact: true }).click();
  await expect(page.getByLabel('Your name', { exact: true })).toBeVisible();
}
async function expectProfile(page: Page, expected: WorkspaceState): Promise<void> {
  await expect(page.getByLabel('Your name', { exact: true })).toHaveValue(expected.profile.name);
  await expect(page.getByRole('combobox', { name: 'Choose your trip' })).toHaveValue(expected.selectedTripId);
  await expectStored(page, expected);
}
async function budget(page: Page): Promise<void> {
  await page.getByRole('button', { name: 'Trip budget', exact: true }).click();
  await expect(page.getByRole('heading', { name: 'The whole picture.', exact: true })).toBeVisible();
}
async function expenses(page: Page, titles: string[]): Promise<void> {
  await expect(page.locator('.expense-row')).toHaveCount(titles.length);
  await expect(page.locator('.expense-row strong')).toHaveText(titles);
}
async function upload(page: Page, kind: 'csv' | 'backup', name: string, buffer: Buffer): Promise<void> {
  const button = kind === 'csv' ? 'Import CSV' : 'Restore a Trippin backup';
  const selector = kind === 'csv' ? csvInput : backupInput;
  await expect(page.locator(selector)).toHaveCount(1);
  const chooserReady = page.waitForEvent('filechooser');
  await page.getByRole('button', { name: button, exact: true }).click();
  const chooser = await chooserReady;
  await chooser.setFiles({ name, mimeType: kind === 'csv' ? 'text/csv' : 'application/json', buffer });
  await expect(page.locator(selector)).toHaveValue('');
}

test.beforeEach(async ({ page, authoredWorkspace, context }) => {
  if (!guards.has(context)) throw new Error('The request guard must precede public navigation.');
  await expectDeployment(await page.goto(ORIGIN, { waitUntil: 'domcontentloaded' }));
  await expect(page.getByRole('combobox', { name: 'Choose your trip' })).toHaveValue(authoredWorkspace.selectedTripId);
  await expectStored(page, authoredWorkspace);
});

test('EUR imports append once and explicit USD rejects without changing existing expenses', async ({ page, authoredWorkspace }) => {
  await budget(page);
  await expenses(page, ['Kept authored expense']);
  await upload(page, 'csv', 'authored-eur.csv', Buffer.from(`title,amount,date,category,currency\nAuthored EUR coffee,5.25,${DATE},food, eUr \n`));
  await expect(page.getByRole('status')).toContainText('1 expenses imported');
  await expenses(page, ['Kept authored expense', 'Authored EUR coffee']);
  await expect.poll(async () => (await stored(page)).trips[0].expenses.map(({ title, amount, date, category }) => ({ title, amount, date, category }))).toEqual([
    { title: 'Kept authored expense', amount: 3.5, date: DATE, category: 'food' },
    { title: 'Authored EUR coffee', amount: 5.25, date: DATE, category: 'food' },
  ]);
  const accepted = await stored(page), rows = accepted.trips[0].expenses;
  expect(rows.slice(0, -1)).toEqual(authoredWorkspace.trips[0].expenses);
  expect(rows.at(-1)).toMatchObject({ title: 'Authored EUR coffee', amount: 5.25, date: DATE, category: 'food' });
  expect(rows.at(-1)!.id).toBeTruthy();
  await upload(page, 'csv', 'authored-usd.csv', Buffer.from(`title,amount,date,category,currency\nMust not become EUR,7,${DATE},food,USD\n`));
  await expect(page.getByRole('status')).toContainText(/only EUR/i);
  await expenses(page, ['Kept authored expense', 'Authored EUR coffee']);
  await expectStored(page, accepted);
  await expectDeployment(await page.reload({ waitUntil: 'domcontentloaded' }));
  await budget(page);
  await expenses(page, ['Kept authored expense', 'Authored EUR coffee']);
  await expectStored(page, accepted);
});

test('ambiguous duplicate and explicit blank currency both reject without losing expenses', async ({ page, authoredWorkspace }) => {
  await budget(page);
  const rejected = [
    ['duplicate-currency.csv', `title,amount,date,category,currency,currency\nAmbiguous,7,${DATE},food,EUR,USD\n`, /one currency|currency column/i],
    ['blank-currency.csv', `title,amount,date,category,currency\nBlank,7,${DATE},food,   \n`, /only EUR/i],
  ] as const;
  for (const [name, csv, message] of rejected) {
    await upload(page, 'csv', name, Buffer.from(csv));
    await expect(page.getByRole('status')).toContainText(message);
    await expenses(page, ['Kept authored expense']);
    await expectStored(page, authoredWorkspace);
  }
});

test.describe('large UTF-8 round trip', () => {
  test.use({ authoredWorkspace: largeWorkspace('漢') });
  test('actual CJK download above two MB restores after a visible profile edit and survives reload', async ({ page, authoredWorkspace }) => {
    await profile(page);
    const ready = page.waitForEvent('download');
    await page.getByRole('button', { name: 'Export backup', exact: true }).click();
    const download = await ready;
    expect(download.suggestedFilename()).toBe('trippin-backup.json');
    expect(await download.failure()).toBeNull();
    const stream = await download.createReadStream();
    if (!stream) throw new Error('The actual browser download has no readable file.');
    const chunks: Buffer[] = [];
    let size = 0;
    for await (const chunk of stream) {
      const bytes = Buffer.from(chunk);
      size += bytes.byteLength;
      if (size > RAW_CAP) throw new Error('The authored download exceeded its bound.');
      chunks.push(bytes);
    }
    const buffer = Buffer.concat(chunks);
    expect(buffer.byteLength).toBeGreaterThan(2_000_000);
    expect(buffer.byteLength).toBeLessThan(RAW_CAP);
    const downloaded: unknown = JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(buffer));
    expect(isWorkspace(downloaded)).toBe(true);
    expect(digest(downloaded)).toBe(digest(authoredWorkspace));
    await page.getByLabel('Your name', { exact: true }).fill('Edited before backup restore');
    await page.getByRole('button', { name: 'Save your profile', exact: true }).click();
    await expect(page.getByRole('status')).toContainText('Profile updated.');
    await expect.poll(async () => (await stored(page)).profile.name).toBe('Edited before backup restore');
    await upload(page, 'backup', download.suggestedFilename(), buffer);
    await expect(page.getByRole('status')).toContainText('Backup restored and saved in this browser.');
    await expectProfile(page, authoredWorkspace);
    await expectDeployment(await page.reload({ waitUntil: 'domcontentloaded' }));
    await profile(page);
    await expectProfile(page, authoredWorkspace);
  });
});

test('legacy pretty backup above two MB restores and invalid UTF-8 cannot replace its UI or durable state', async ({ page }) => {
  await profile(page);
  const legacy = largeWorkspace('x'), pretty = Buffer.from(JSON.stringify(legacy, null, 2));
  expect(pretty.byteLength).toBeGreaterThan(2_000_000);
  expect(pretty.byteLength).toBeLessThan(RAW_CAP);
  await upload(page, 'backup', 'authored-legacy-pretty.json', pretty);
  await expect(page.getByRole('status')).toContainText('Backup restored and saved in this browser.');
  await expectProfile(page, legacy);
  const malformed = workspace();
  malformed.profile.name = 'AUTHORED-UTF8-MARKER';
  const invalidBytes = Buffer.from(JSON.stringify(malformed));
  const offset = invalidBytes.indexOf('AUTHORED-UTF8-MARKER');
  expect(offset).toBeGreaterThanOrEqual(0);
  invalidBytes[offset] = 0xff;
  // A permissive File.text decoder would yield model-valid replacement text.
  expect(isWorkspace(JSON.parse(invalidBytes.toString('utf8')))).toBe(true);
  await upload(page, 'backup', 'authored-invalid-utf8.json', invalidBytes);
  await expect(page.getByRole('status')).toContainText(/not a valid UTF-8 Trippin backup/i);
  await expectProfile(page, legacy);
  await expectDeployment(await page.reload({ waitUntil: 'domcontentloaded' }));
  await profile(page);
  await expectProfile(page, legacy);
});

test('an active user zoom retires safely on profile navigation and the replacement map remains usable', async ({ page, authoredWorkspace }, testInfo) => {
  const mobile = testInfo.project.name === 'mobile-chromium';
  if (mobile) await page.getByRole('button', { name: 'Show map', exact: true }).click();
  const currentMap = page.getByRole('region', { name: `Map of ${authoredWorkspace.trips[0].city}`, exact: true });
  await expect(currentMap.locator('.leaflet-container')).toHaveCount(1);
  const oldHost = await currentMap.locator('.leaflet-container').elementHandle();
  if (!oldHost) throw new Error('The displayed map has no public container.');
  const profileButton = page.getByRole('button', { name: 'Your profile', exact: true });
  const clickObservation = await profileButton.evaluateHandle(button => {
    const listener = (event: Event) => {
      button.setAttribute('data-trippin-qa-zoom-active', event.isTrusted && document.querySelector('.leaflet-zoom-anim') !== null ? 'true' : 'false');
    };
    button.addEventListener('click', listener, { capture: true, once: true });
    return { button, listener };
  });
  try {
    await currentMap.getByRole('button', { name: 'Zoom in', exact: true }).click();
    await expect(currentMap.locator('.leaflet-zoom-anim')).toHaveCount(1);
    await profileButton.click();
    await expect(profileButton).toHaveAttribute('data-trippin-qa-zoom-active', 'true');
    await expectProfile(page, authoredWorkspace);
    await expect.poll(() => oldHost.evaluate(host => host.isConnected)).toBe(false);
    await expect.poll(() => oldHost.evaluate(host => host.childElementCount)).toBe(0);
  } finally {
    try {
      await clickObservation.evaluate(({ button, listener }) => {
        button.removeEventListener('click', listener, true);
        button.removeAttribute('data-trippin-qa-zoom-active');
      });
    } finally {
      await Promise.all([clickObservation.dispose(), oldHost.dispose()]);
    }
  }
  await page.getByRole('button', { name: /^My trips/ }).click();
  await expect(currentMap).toBeVisible();
  await expect(currentMap.locator('.place-marker')).toHaveCount(1);
  await currentMap.getByRole('button', { name: 'Zoom in', exact: true }).click();
  await expect(currentMap.locator('.leaflet-zoom-anim')).toHaveCount(1);
  await expect(currentMap.locator('.leaflet-zoom-anim')).toHaveCount(0);
  await expectStored(page, authoredWorkspace);
  await expectDeployment(await page.reload({ waitUntil: 'domcontentloaded' }));
  if (mobile) await page.getByRole('button', { name: 'Show map', exact: true }).click();
  await expect(currentMap.locator('.place-marker')).toHaveCount(1);
  await expectStored(page, authoredWorkspace);
});

