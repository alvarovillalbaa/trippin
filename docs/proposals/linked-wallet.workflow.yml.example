# INACTIVE EXAMPLE. Root replaces the preparation SHA and publishes only the
# reviewed branch-scoped temporary workflow; this file itself cannot run.
name: Trippin linked wallet 2
on: create
permissions:
  contents: read
concurrency:
  group: trippin-wallet-20261107-2
  cancel-in-progress: false
jobs:
  linked-wallet:
    if: >-
      github.event.ref_type == 'branch' &&
      github.event.ref == 'qa/trippin-wallet-20261107-2' &&
      github.repository == 'alvarovillalbaa/trippin' &&
      github.event.repository.private == false
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    env:
      CI: 'true'
      SOURCE_COMMIT: PREPARATION_SHA_REPLACED_BY_ROOT
      TRIPPIN_WALLET_PUBLIC_REPOSITORY: 'true'
      TRIPPIN_WALLET_EXPECTED_DEPLOYMENT: dpl_BASnM5VtYvhPWUKnW4hcE5VDhodd
    steps:
      - name: Record earliest owned job step
        shell: bash
        run: echo "TRIPPIN_WALLET_JOB_STARTED_MS=$(date +%s%3N)" >> "$GITHUB_ENV"
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: ${{ env.SOURCE_COMMIT }}
          fetch-depth: 2
          persist-credentials: false
          clean: false
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1
        with:
          node-version: '24.21.0'
          check-latest: false
      - name: Two first linked wallet journeys and owned cleanup
        shell: bash
        run: node tests/scripts/run-linked-wallet-checks.mjs --source-commit "$SOURCE_COMMIT"
