# Server-only. Enable the public, read-only planning assistant explicitly.
TRIPPIN_AI_ENABLED=false
# Use a Vercel AI Gateway key, or configure project OIDC in Vercel.
AI_GATEWAY_API_KEY=

# Optional public trip directory and join requests (server-only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional live flight status and event discovery (server-only).
FLIGHTAWARE_API_KEY=
TICKETMASTER_API_KEY=

# Optional Plaid demo; real bank connections are deliberately unavailable.
TRIPPIN_BANK_SANDBOX_ENABLED=false
PLAID_CLIENT_ID=
PLAID_SANDBOX_SECRET=
